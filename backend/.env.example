# Cadena de conexión a PostgreSQL (Prisma 7 + adaptador pg).
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=

# Secreto para firmar/verificar los JWT de la API (HS256).
# Distinto del SESSION_SECRET del frontend. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Vigencia de los JWT emitidos. Opcional; por defecto 7d.
JWT_EXPIRES_IN=7d

# API key de Google Gemini (@google/genai) para la generación de texto con IA.
# Si falta, la app arranca igual y solo falla la primera llamada a la IA.
GEMINI_API_KEY=

# Proveedor de IA para plan de estudio y explicaciones: "gemini" | "ollama".
# Por defecto gemini. "ollama" apunta a un servidor Ollama (endpoint nativo
# /api/chat, stream, think:false, num_ctx explícito, format=JSON Schema).
PROVEEDOR_IA=gemini
OLLAMA_URL=https://ollama.nuiti.org
OLLAMA_MODEL=qwen3:8b
# Ventana de contexto de Ollama; el default del modelo trunca respuestas largas.
OLLAMA_NUM_CTX=8192

# "true" habilita los endpoints de solo-demo (fuera de demo responden 404).
DEMO_MODE=false

# "true" expone la documentación Swagger en /docs.
SWAGGER_ENABLED=false

# "true" -> las explicaciones de las preguntas falladas del diagnóstico se
# generan con texto de relleno plausible en vez de llamar a Gemini. Útil para
# probar el flujo sin gastar cuota ni depender de la API.
GEMINI_MOCK_EXPLICACIONES=false

# Puerto HTTP del backend. Opcional; por defecto 3000.
PORT=3000
